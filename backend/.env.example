# ChangeGuard AI Environment Configuration

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_STR=/api/v1

# Database Configuration
# Local SQLite fallback:
DATABASE_URL=sqlite:///./changeguard.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://changeguard_user:changeguard_password@localhost:5432/changeguard_db

# CORS Configuration (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Isolated Pytest / Docker Test Runner Settings
DOCKER_IMAGE=changeguard-runner:latest
DOCKER_TIMEOUT_SECONDS=60
DOCKER_MEMORY_LIMIT=512m
DOCKER_CPU_LIMIT=1.0
DOCKER_PIDS_LIMIT=100
# Replace with existing absolute directories visible to the backend process.
APPROVED_PROJECT_ROOTS=["C:/changeguard/projects"]

# Module Integrations
ANALYZER_MODULE_ENABLED=true
TEST_SELECTOR_MODULE_ENABLED=true
